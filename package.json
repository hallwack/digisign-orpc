{
  "name": "digisign",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "elysia": "^1.4.21",
      "@orpc/server": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "better-auth": "^1.4.9",
      "@orpc/client": "^1.12.2"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "mkdir -p storage/documents",
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "rm -rf storage/documents/*",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @digisign/db db:push",
    "db:studio": "turbo -F @digisign/db db:studio",
    "db:generate": "turbo -F @digisign/db db:generate",
    "db:migrate": "turbo -F @digisign/db db:migrate",
    "db:start": "turbo -F @digisign/db db:start",
    "db:watch": "turbo -F @digisign/db db:watch",
    "db:stop": "turbo -F @digisign/db db:stop",
    "db:down": "turbo -F @digisign/db db:down",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f"
  },
  "dependencies": {
    "@digisign/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@digisign/config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "catalog:",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier": "^3.8.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
