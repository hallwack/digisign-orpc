{
  "name": "@digisign/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@digisign/env": "workspace:*",
    "@digisign/types": "workspace:*",
    "@noble/curves": "^2.3.0",
    "@node-rs/argon2": "^2.1.0",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.17.1",
    "pizzip": "^3.2.0",
    "xml2js": "^0.6.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@digisign/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.16.0",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  }
}
